# /etc/ziv-backup-enviar.env on the server, owned by root (deploy/backup-enviar.sh).
# Where the copies go off the machine. Today a Google Cloud bucket; the VM
# runs as the service account ziv-copias, which can only create objects there.
BACKUP_DEST=gs://NOME-DO-BUCKET/ziv
#BACKUP_SRC_DIR=/home/ziv/backups
#BACKUP_STATE=/var/lib/ziv-backup/enviados
