# ~/ziv/backup.env on the server (deploy/backup-banco.sh). No secret here:
# the copy is sealed with a PUBLIC key; the private one stays with the Henry.
BACKUP_RECIPIENT_FILE=$HOME/ziv/backup-recipient.txt
BACKUP_DIR=$HOME/backups
BACKUP_KEEP=7
# Where the copy goes off the machine. Today a Google Cloud bucket; a
# client's own storage later only changes this line (and the key file).
BACKUP_DEST=gs://NOME-DO-BUCKET/ziv
# Who uploads: by default the VM's own identity (the VM runs as the service
# account ziv-copias, which can only create objects in that bucket; no key
# file). Only a server outside Google Cloud needs a key file:
#BACKUP_GCP_KEY_FILE=$HOME/ziv/backup-gcp.json
# How the dump is made (default shown).
#BACKUP_DUMP_CMD='podman exec ziv-db pg_dumpall -U postgres'
