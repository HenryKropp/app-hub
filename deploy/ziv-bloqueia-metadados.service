# The apps run as the user ziv (rootless Podman): their connections leave
# through processes of that user. This blocks that user from the Google
# metadata server (169.254.169.254), so an app cannot take the VM identity.
# DNS (port 53) stays open: the containers resolve names through it.
# Install: /etc/systemd/system/, then systemctl enable --now.
[Unit]
Description=Ziv: usuário dos apps não fala com o servidor de metadados do Google
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/iptables -I OUTPUT -d 169.254.169.254 -p tcp ! --dport 53 -m owner --uid-owner ziv -j REJECT
ExecStop=/usr/sbin/iptables -D OUTPUT -d 169.254.169.254 -p tcp ! --dport 53 -m owner --uid-owner ziv -j REJECT

[Install]
WantedBy=multi-user.target
