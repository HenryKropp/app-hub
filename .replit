modules = ["web", "nodejs-24", "go-1.25", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.development]
BASE_URL = "https://d8b51bed-d483-4654-af88-b7340389c831-00-pzpeyw2cylsm.riker.replit.dev"
GOSUMDB = "sum.golang.org"
PORT = "5000"
AGENT_BINARY_PATH = "dist/agent/AppHubAgente.exe"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-replit.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
