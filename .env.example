# Shared apps (apps compartilhados). Copy to .env and fill in.
# gerar com: cd backend && mise x -- go run ./cmd/newkey
HUB_SECRET_KEY=
# Portal credential vault: configure ONLY in workspace Secrets, not in .env.
# CREDENTIAL_VAULT_KEYRING (independent versioned keyring; see docs/CREDENTIAL_VAULT.md)
# APPS_DB_ADMIN_URL=            # default: DATABASE_URL
# APPS_DB_HOST_FOR_CONTAINERS=host.containers.internal:5433
# APPS_DB_CONTAINER=ziv-db        # default; on first start an old kova-db (or app-hub-db) is renamed to it
# SHARED_APPS_DOMAIN=localhost:8080   # apps answer on <slug>.localhost:8080
# BASE_URL (Hub address people use, e.g. http://localhost:5173) is where app
# addresses send people to sign in; it must be set for shared apps.
# SHARED_DATA_DIR=              # default: ~/.local/share/ziv/shared (an old kova or app-hub folder is adopted)
# CONTAINER_ENGINE=podman
